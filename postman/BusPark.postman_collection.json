        }
      }
    },
    {
      "name": "3 POST автобус қосу (оң)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('busId', pm.response.json()._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/buses"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"plate\": \"123 ABC 02\",\n  \"brand\": \"MAN\",\n  \"driver\": \"Ермек Асанов\",\n  \"status\": \"Жарамды\"\n}"
        }
      }
    },
